# Local H2 file database (the database files stay under backend/data).
DATABASE_URL=jdbc:h2:file:./data/essp_db;DB_CLOSE_ON_EXIT=FALSE
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Optional Base64-encoded 256-bit HMAC key. Generate a different value for each environment.
APP_JWT_SECRET=replace-with-a-private-base64-encoded-32-byte-key

# Initial administrator: set these only when provisioning an empty database.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMPLOYEE_ID=
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_DEPARTMENT=
APP_BOOTSTRAP_ADMIN_DESIGNATION=
APP_BOOTSTRAP_ADMIN_JOINING_DATE=

# Optional fictional demo accounts; set ESSP_SEED_DEMO_DATA=true and a private password.
ESSP_SEED_DEMO_DATA=false
APP_DEMO_PASSWORD=
