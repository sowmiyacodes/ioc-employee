{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start ESSP frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Install ESSP frontend dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify ESSP frontend",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-sS",
				"-I",
				"http://127.0.0.1:3000/"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify local authentication health endpoint",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-sS",
				"-i",
				"http://localhost:8080/api/auth/health"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}